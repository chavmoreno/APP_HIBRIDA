# ---- API Gateway (:8000) y worker de alertas — se ejecutan en Docker en la VM de Oracle Cloud ----
# Copia este archivo a .env y ajusta los valores. NUNCA subas .env al repositorio.
# HOST, PORT, certificados, INFERENCE_URL, INFERENCE_CA_BUNDLE, FIREBASE_CREDENTIALS y LOG_FALLBACK_PATH
# los fija docker-compose.yml (no hace falta ponerlos aquí).

# Swagger UI en vivo en /docs (útil en desarrollo; en producción déjalo en false)
EXPONER_DOCS=false

# Orígenes permitidos para CORS (dominios de Firebase Hosting), separados por coma. Sólo https://
CORS_ORIGINS=https://TU-PROYECTO.web.app,https://TU-PROYECTO.firebaseapp.com

# Hosts aceptados en la cabecera Host (tu dominio de DuckDNS + localhost)
ALLOWED_HOSTS=tu-app.duckdns.org,localhost,127.0.0.1

# Proyecto de Firebase. La cuenta de servicio (Consola Firebase → Configuración → Cuentas de servicio →
# Generar clave) va en api-gateway/secrets/firebase-service-account.json de la VM.
FIREBASE_PROJECT_ID=TU-PROYECTO

# Correos con acceso al panel de administración de errores
ADMIN_EMAILS=tu-correo@gmail.com

# Llave compartida con el microservicio de inferencia (la MISMA que en inference-service/.env)
INTERNAL_API_KEY=cambia-esta-llave

# Bases de datos en XAMPP (usuarios con privilegios mínimos, ver database/*.sql).
# XAMPP vive en el PC de casa; el túnel SSH inverso (scripts/tunel_mysql.bat) lo publica en 127.0.0.1:3306 de la VM.
CONSULTAS_DB_URL=mysql+pymysql://app_consultas:cambia-esta-clave@127.0.0.1:3306/consultas_db?charset=utf8mb4
ERRORES_DB_URL=mysql+pymysql://app_errores:cambia-esta-clave@127.0.0.1:3306/errores_db?charset=utf8mb4
ERRORES_ADMIN_DB_URL=mysql+pymysql://app_errores_admin:cambia-esta-clave@127.0.0.1:3306/errores_db?charset=utf8mb4

# Sal para anonimizar IPs (hash) en el log de errores
IP_HASH_SALT=cambia-esta-sal

# ---- Alertas de errores críticos (worker app.alertas) ----
# Telegram (opcional): crea un bot con @BotFather y obtén tu chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Correo (opcional): SMTP con STARTTLS, p. ej. Gmail con contraseña de aplicación
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
