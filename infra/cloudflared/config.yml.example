# Configuración de Cloudflare Tunnel (cloudflared) — copia a ~/.cloudflared/config.yml
# (Windows: C:\Users\<tu-usuario>\.cloudflared\config.yml) y reemplaza los valores.
#
# El túnel abre una conexión SALIENTE cifrada hacia Cloudflare: no necesitas abrir puertos en tu router.
# Cloudflare termina el TLS público en https://api.tudominio.com y reenvía al gateway local por HTTPS.

tunnel: <ID-DEL-TUNEL>                       # Lo muestra "cloudflared tunnel create stroke-api"
credentials-file: C:\Users\<tu-usuario>\.cloudflared\<ID-DEL-TUNEL>.json

ingress:
  - hostname: api.tudominio.com
    service: https://localhost:8000          # API Gateway (HTTPS con certificado mkcert)
    originRequest:
      originServerName: localhost            # Debe coincidir con el SAN del certificado
      caPool: C:\ruta\a\APP_HIBRIDA\infra\certs\rootCA.pem   # Verifica el certificado local (no usar noTLSVerify)
      httpHostHeader: api.tudominio.com
  # Todo lo demás se rechaza. El microservicio de inferencia (:8001) NUNCA se publica.
  - service: http_status:404
