# ---- Microservicio de inferencia (:8001) — se ejecuta en Docker en la VM de Oracle Cloud ----
# Copia este archivo a .env y ajusta los valores. NUNCA subas .env al repositorio.
# docker-compose.yml lo pasa al contenedor. HOST, PORT y las rutas de los certificados
# los fija docker-compose.yml (no hace falta ponerlos aquí).

# Paquete del modelo, relativo a /app dentro del contenedor (= inference-service/models en tu disco).
# Para publicar otra versión: copia model_v2.joblib a models/, cambia esta línea y
# ejecuta "docker compose up -d" (recrea el contenedor con el nuevo valor).
MODEL_PATH=models/model_v1.joblib

# Llave compartida con el API Gateway (cabecera X-Internal-API-Key). Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_KEY=cambia-esta-llave

# Base de datos de log de errores en XAMPP (usuario con permiso sólo de INSERT).
# XAMPP vive en el PC de casa; el túnel SSH inverso (scripts/tunel_mysql.bat) lo publica en 127.0.0.1:3306 de la VM.
ERRORES_DB_URL=mysql+pymysql://app_errores:cambia-esta-clave@127.0.0.1:3306/errores_db?charset=utf8mb4

# Archivo de respaldo rotativo si MySQL no responde o el túnel está caído (volumen Docker "inferencia-logs")
LOG_FALLBACK_PATH=logs/errores_respaldo.log
