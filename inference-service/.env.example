# ---- Microservicio de inferencia (:8001) ----
# Copia este archivo a .env y ajusta los valores. NUNCA subas .env al repositorio.

# Sólo escucha en loopback: el único cliente es el API Gateway de la misma máquina
HOST=127.0.0.1
PORT=8001

# Certificado TLS local (generado con mkcert, ver docs/manual_instalacion.md)
SSL_CERTFILE=../infra/certs/localhost.pem
SSL_KEYFILE=../infra/certs/localhost-key.pem

# Ruta al paquete exportado desde Colab
MODEL_PATH=models/model_v1.joblib

# Llave compartida con el API Gateway (cabecera X-Internal-API-Key). Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_KEY=cambia-esta-llave

# Base de datos de log de errores en XAMPP (usuario con permiso sólo de INSERT)
ERRORES_DB_URL=mysql+pymysql://app_errores:cambia-esta-clave@127.0.0.1:3306/errores_db?charset=utf8mb4

# Archivo de respaldo rotativo si MySQL no responde
LOG_FALLBACK_PATH=logs/errores_respaldo.log
